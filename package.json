{
  "name": "computerstoreai",
  "version": "1.0.0",
  "private": true,
  "description": "ComputerStoreAI - E-commerce platform for PCs and Laptops (monorepo)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm run build --workspace=frontend"
  },
  "browserslist": [
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 14",
    "edge >= 90"
  ]
}
