datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id    Int    @id @default(autoincrement())
  name  String
  price Int
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         String   @default("USER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
